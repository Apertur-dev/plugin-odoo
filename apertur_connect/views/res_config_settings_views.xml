<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_apertur" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.apertur</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Apertur" string="Apertur" name="apertur_connect">
                    <block title="Apertur - Photo Collection" name="apertur_main">

                        <div class="alert alert-warning"
                             role="alert"
                             invisible="not apertur_is_sandbox">
                            <i class="fa fa-flask me-2"/>
                            <strong>Sandbox mode active.</strong>
                            Using test environment — images will be watermarked.
                        </div>
                        <field name="apertur_is_sandbox" invisible="1"/>

                        <setting string="API Key"
                                 help="Your Apertur API key. Obtain one from apertur.ca.">
                            <field name="apertur_api_key"
                                   placeholder="aptr_live_..."
                                   password="True"/>
                        </setting>

                        <setting string="Webhook Secret"
                                 help="Secret used to verify incoming webhook signatures (HMAC-SHA256).">
                            <field name="apertur_webhook_secret"
                                   password="True"/>
                        </setting>

                        <setting string="Destination ID"
                                 help="Required. UUID of the Apertur destination of type 'odoo' that will receive photos. Create the destination from your Apertur dashboard (Destinations &gt; Add destination &gt; Odoo) and paste its ID here.">
                            <field name="apertur_destination_id"
                                   placeholder="00000000-0000-0000-0000-000000000000"/>
                        </setting>

                        <setting string="API Base URL"
                                 help="Override the API base URL. Leave empty to auto-detect from the key prefix.">
                            <field name="apertur_base_url"
                                   placeholder="https://api.aptr.ca"/>
                        </setting>

                        <setting string="Default Max Images"
                                 help="Default max images per session.">
                            <field name="apertur_default_max_images"/>
                        </setting>

                        <setting string="Enabled Models"
                                 help="Models where Apertur capture is available. Only models that have a chatter (mail thread) are listed.">
                            <field name="apertur_enabled_model_ids"
                                   widget="many2many_checkboxes"/>
                        </setting>

                    </block>

                    <block title="Webhook Endpoint" name="apertur_webhook">
                        <setting string="Webhook URL"
                                 help="Configure the following URL as a webhook destination in your Apertur dashboard.">
                            <field name="apertur_webhook_url" readonly="1" widget="CopyClipboardChar"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
